<Window x:Class="MessangersUI.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="577" Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="450" MinWidth="650"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Стиль для заголовков секций -->
        <Style x:Key="SectionHeaderStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Стиль для меток настроек -->
        <Style x:Key="SettingLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для ToggleButton -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="BackgroundBorder" CornerRadius="13" 
                                    Background="#2a2a4a" BorderThickness="0"/>
                            <Border x:Name="ThumbBorder" CornerRadius="13" 
                                    Width="22" Height="22" 
                                    HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#00d2ff" Offset="0"/>
                                        <GradientStop Color="#3a7bd5" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" 
                                        Value="#0f3460"/>
                                <Setter TargetName="ThumbBorder" Property="HorizontalAlignment" 
                                        Value="Right"/>
                                <Setter TargetName="ThumbBorder" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2a2a4a"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" 
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Fill="White" Margin="8,0,0,0"
                                          Data="M0,0 L5,5 L10,0 Z" Stretch="Uniform"
                                          Width="10" Height="6"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsDropDownOpen, 
                                   RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" StaysOpen="False">
                                <Border Background="#1a1a2e" BorderBrush="#0f3460" 
                                        BorderThickness="1" CornerRadius="8" 
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0f3460"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#0f3460"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Стиль для кнопок -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточек настроек -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Стиль для вкладок TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Заголовки вкладок -->
                            <Border Grid.Row="0" 
                                    Background="#0f3460" 
                                    CornerRadius="10,10,0,0"
                                    Padding="10,0">
                                <TabPanel x:Name="HeaderPanel"
                                          Panel.ZIndex="1"
                                          IsItemsHost="True"
                                          Background="Transparent"/>
                            </Border>

                            <!-- Содержимое вкладок -->
                            <Border Grid.Row="1"
                                    Background="#1a1a2e"
                                    CornerRadius="0,0,10,10"
                                    BorderBrush="#0f3460"
                                    BorderThickness="1">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для элементов TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#aaaaaa"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border Name="Border" 
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0,0,0,3"
                                    BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="ContentSite"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#00d2ff"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Основной фон -->
    <Grid Height="550" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#1a1a2e" Offset="0"/>
                <GradientStop Color="#16213e" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Заголовок окна -->
        <Border Height="60" Background="#0f3460" VerticalAlignment="Top">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Content="⚙ НАСТРОЙКИ" HorizontalAlignment="Left" 
                       VerticalAlignment="Center" FontSize="18" 
                       FontFamily="Segoe UI Black" Foreground="White"
                       Grid.Column="0"/>

                <Label Content="Управление параметрами приложения" 
                       HorizontalAlignment="Left" VerticalAlignment="Center" 
                       FontSize="12" FontFamily="Segoe UI" Foreground="#aaaaaa" 
                       Margin="10,0,0,0" Grid.Column="1"/>

                <Button x:Name="CloseSettingsButton" Grid.Column="2"
                        Content="✕" FontSize="18" Width="35" Height="35"
                        HorizontalContentAlignment="Center" 
                        Background="Transparent" Foreground="#aaaaaa"
                        BorderThickness="0" Cursor="Hand" Click="CloseSettingsButton_Click"
                        >
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- TabControl с настройками -->
        <TabControl x:Name="MainTabControl" Margin="20,80,20,20">

            <TabItem Header="👤 ПРОФИЛЬ">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              Padding="20">
                    <StackPanel>
                        <Label Style="{StaticResource SectionHeaderStyle}" 
                               Content="ИНФОРМАЦИЯ ПРОФИЛЯ"/>

                        <!-- Аватарка -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Аватарка с возможностью смены -->
                                <Border Grid.Column="0" Width="80" Height="80" 
                                        CornerRadius="40" 
                                        Background="#00d2ff" 
                                        Margin="0,0,20,0">
                                    <Image x:Name="ImageAvatar"  Width="80" Height="80" Stretch="UniformToFill">
                                        
                                    </Image>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Label Content="Аватар профиля" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="White" Margin="0,0,0,5"/>
                                    <Label Content="PNG, JPG до 5 МБ" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           FontSize="11" Foreground="#888888"/>
                                </StackPanel>

                                <Button Grid.Column="2" 
                                        Content="📷 СМЕНИТЬ" 
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="#00d2ff" Width="120" Click="Button_Click"/>
                            </Grid>
                        </Border>

                        <!-- Имя пользователя -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0" Content="👤" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>

                                <StackPanel Grid.Column="1">
                                    <Label Content="Имя пользователя" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           FontSize="11" Foreground="#888888"
                                           Margin="0,0,0,2"/>
                                    <Label x:Name="UsernameText" 
                                             HorizontalAlignment="Left"
                                             Width="250" Height="35"/>
                                </StackPanel>

                                <Button Grid.Column="2" 
                                        Content="💾 СОХРАНИТЬ" 
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="#0f3460" Width="100"
                                        Margin="10,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Статус -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0" Content="💬" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>

                                <StackPanel Grid.Column="1">
                                    <Label Content="Статус" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           FontSize="11" Foreground="#888888"
                                           Margin="0,0,0,2"/>
                                    <ComboBox x:Name="StatusCombo" Width="200">
                                        <ComboBoxItem Content="🟢 В сети" IsSelected="True"/>
                                        <ComboBoxItem Content="🟡 Не беспокоить"/>
                                        <ComboBoxItem Content="🔴 Не в сети"/>
                                        <ComboBoxItem Content="🌙 Отошел"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button Grid.Column="2" 
                                        Content="💾 СОХРАНИТЬ" 
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="#0f3460" Width="100"
                                        Margin="10,0,0,0"/>
                            </Grid>
                        </Border>

                        <Label Style="{StaticResource SectionHeaderStyle}" 
                               Content="БЕЗОПАСНОСТЬ" Margin="0,20,0,15"/>

                        <!-- Смена пароля -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <Label Content="🔑 СМЕНА ПАРОЛЯ" 
                                       Style="{StaticResource SettingLabelStyle}"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="White" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0" Content="Текущий пароль" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           FontSize="12"/>
                                    <PasswordBox Grid.Column="1" 
                                                 x:Name="CurrentPasswordBox"
                                                 Width="250" 
                                                 HorizontalAlignment="Left"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0" Content="Новый пароль" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           FontSize="12"/>
                                    <PasswordBox Grid.Column="1" 
                                                 x:Name="NewPasswordBox"
                                                 Width="250" 
                                                 HorizontalAlignment="Left"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0" Content="Подтверждение" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           FontSize="12"/>
                                    <PasswordBox Grid.Column="1" 
                                                 x:Name="ConfirmPasswordBox"
                                                 Width="250" 
                                                 HorizontalAlignment="Left"/>
                                </Grid>

                                <Button Content="🔐 СМЕНИТЬ ПАРОЛЬ" 
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="#00d2ff" Width="180"
                                        x:Name="ButtonPassword"
                                        HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <!-- Дополнительные настройки профиля -->
                        <Label Style="{StaticResource SectionHeaderStyle}" 
                               Content="ДОПОЛНИТЕЛЬНО" Margin="0,20,0,15"/>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0" Content="📧" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>

                                <StackPanel Grid.Column="1">
                                    <Label Content="Email" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           FontSize="11" Foreground="#888888"
                                           Margin="0,0,0,2"/>
                                    <Label x:Name="EmailTextBox" 
                                             Width="250" Height="35"/>
                                </StackPanel>

                                <Button Grid.Column="2" 
                                        Content="💾 СОХРАНИТЬ" 
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="#0f3460" Width="100"
                                        Margin="10,0,0,0"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0" Content="📱" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>

                                <StackPanel Grid.Column="1">
                                    <Label Content="Номер телефона" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           FontSize="11" Foreground="#888888"
                                           Margin="0,0,0,2"/>
                                    <Label x:Name="PhoneTextBox" 
                                             Width="250" Height="35"/>
                                </StackPanel>

                                <Button Grid.Column="2" 
                                        Content="💾 СОХРАНИТЬ" 
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="#0f3460" Width="100"
                                        Margin="10,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Дата регистрации -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0" Content="📅" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>

                                <StackPanel Grid.Column="1">
                                    <Label Content="Дата регистрации" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           FontSize="11" Foreground="#888888"
                                           Margin="0,0,0,2"/>
                                    <Label Content="01.01.2024" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           FontSize="14" Foreground="White"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- ===== ВКЛАДКА: ОБЩИЕ ===== -->
            <TabItem Header="📋 ОБЩИЕ">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              Padding="20">
                    <StackPanel>
                        <Label Style="{StaticResource SectionHeaderStyle}" 
                               Content="ОСНОВНЫЕ ПАРАМЕТРЫ"/>

                        <!-- Запуск при старте -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="🚀" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Запускать приложение вместе с Windows"/>
                                <ToggleButton Grid.Column="2" x:Name="AutoStartToggle"
                                              Style="{StaticResource ToggleButtonStyle}"
                                              IsChecked="False"/>
                            </Grid>
                        </Border>

                        <!-- Язык -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="🌐" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Язык интерфейса"/>
                                <ComboBox Grid.Column="2" x:Name="LanguageCombo"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Русский"/>
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Deutsch"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Тема -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="🌙" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Тема оформления"/>
                                <ComboBox Grid.Column="2" x:Name="ThemeCombo"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Тёмная"/>
                                    <ComboBoxItem Content="Светлая"/>
                                    <ComboBoxItem Content="Системная"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Button x:Name="SaveGeneralSettings" 
                                Content="💾 СОХРАНИТЬ НАСТРОЙКИ" 
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#0f3460" Width="200" Height="45"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== ВКЛАДКА: ВНЕШНИЙ ВИД ===== -->
            <TabItem Header="🎨 ВНЕШНИЙ ВИД">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              Padding="20">
                    <StackPanel>
                        <Label Style="{StaticResource SectionHeaderStyle}" 
                               Content="НАСТРОЙКИ ОТОБРАЖЕНИЯ"/>

                        <!-- Размер шрифта -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="🔤" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Размер шрифта"/>
                                <ComboBox Grid.Column="2" x:Name="FontSizeCombo"
                                          SelectedIndex="1">
                                    <ComboBoxItem Content="Маленький"/>
                                    <ComboBoxItem Content="Средний"/>
                                    <ComboBoxItem Content="Большой"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Показывать аватарки -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="🖼️" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Отображать аватарки контактов"/>
                                <ToggleButton Grid.Column="2" x:Name="ShowAvatarsToggle"
                                              Style="{StaticResource ToggleButtonStyle}"
                                              IsChecked="True"/>
                            </Grid>
                        </Border>

                        <!-- Анимации -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="✨" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Включить анимации интерфейса"/>
                                <ToggleButton Grid.Column="2" x:Name="AnimationsToggle"
                                              Style="{StaticResource ToggleButtonStyle}"
                                              IsChecked="True"/>
                            </Grid>
                        </Border>

                        <!-- Компактный режим -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="📐" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Компактный режим отображения"/>
                                <ToggleButton Grid.Column="2" x:Name="CompactModeToggle"
                                              Style="{StaticResource ToggleButtonStyle}"
                                              IsChecked="False"/>
                            </Grid>
                        </Border>

                        <Button x:Name="SaveAppearanceSettings" 
                                Content="💾 СОХРАНИТЬ НАСТРОЙКИ" 
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#0f3460" Width="200" Height="45"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== ВКЛАДКА: УВЕДОМЛЕНИЯ ===== -->
            <TabItem Header="🔔 УВЕДОМЛЕНИЯ">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              Padding="20">
                    <StackPanel>
                        <Label Style="{StaticResource SectionHeaderStyle}" 
                               Content="НАСТРОЙКИ УВЕДОМЛЕНИЙ"/>

                        <!-- Звук уведомлений -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="🔊" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Звук новых сообщений"/>
                                <ToggleButton Grid.Column="2" x:Name="SoundToggle"
                                              Style="{StaticResource ToggleButtonStyle}"
                                              IsChecked="True"/>
                            </Grid>
                        </Border>

                        <!-- Всплывающие уведомления -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="💬" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Показывать всплывающие уведомления"/>
                                <ToggleButton Grid.Column="2" x:Name="PopupNotificationsToggle"
                                              Style="{StaticResource ToggleButtonStyle}"
                                              IsChecked="True"/>
                            </Grid>
                        </Border>

                        <!-- Звук при отправке -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="📤" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Звук при отправке сообщения"/>
                                <ToggleButton Grid.Column="2" x:Name="SendSoundToggle"
                                              Style="{StaticResource ToggleButtonStyle}"
                                              IsChecked="False"/>
                            </Grid>
                        </Border>

                        <!-- Уведомления для всех контактов -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="👥" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Включить уведомления для всех контактов"/>
                                <ToggleButton Grid.Column="2" x:Name="AllContactsNotificationsToggle"
                                              Style="{StaticResource ToggleButtonStyle}"
                                              IsChecked="True"/>
                            </Grid>
                        </Border>

                        <Button x:Name="SaveNotificationsSettings" 
                                Content="💾 СОХРАНИТЬ НАСТРОЙКИ" 
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#0f3460" Width="200" Height="45"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== ВКЛАДКА: КОНФИДЕНЦИАЛЬНОСТЬ ===== -->
            <TabItem Header="🔒 КОНФИДЕНЦИАЛЬНОСТЬ">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              Padding="20">
                    <StackPanel>
                        <Label Style="{StaticResource SectionHeaderStyle}" 
                               Content="БЕЗОПАСНОСТЬ И КОНФИДЕНЦИАЛЬНОСТЬ"/>

                        <!-- Онлайн статус -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="🟢" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Показывать статус «В сети»"/>
                                <ToggleButton Grid.Column="2" x:Name="OnlineStatusToggle"
                                              Style="{StaticResource ToggleButtonStyle}"
                                              IsChecked="True"/>
                            </Grid>
                        </Border>

                        <!-- Шифрование -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="🔐" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Сквозное шифрование сообщений"/>
                                <ToggleButton Grid.Column="2" x:Name="EncryptionToggle"
                                              Style="{StaticResource ToggleButtonStyle}"
                                              IsChecked="True"/>
                            </Grid>
                        </Border>

                        <!-- Чтение/удаление -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="👁️" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Показывать статус прочтения"/>
                                <ToggleButton Grid.Column="2" x:Name="ReadReceiptsToggle"
                                              Style="{StaticResource ToggleButtonStyle}"
                                              IsChecked="True"/>
                            </Grid>
                        </Border>

                        <!-- Автоудаление -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="🗑️" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Автоудаление сообщений через"/>
                                <ComboBox Grid.Column="2" x:Name="AutoDeleteCombo"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Никогда"/>
                                    <ComboBoxItem Content="1 день"/>
                                    <ComboBoxItem Content="7 дней"/>
                                    <ComboBoxItem Content="30 дней"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Блокировка приложения -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="🔒" FontSize="18" 
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Label Grid.Column="1" Style="{StaticResource SettingLabelStyle}"
                                       Content="Блокировка приложения паролем"/>
                                <ToggleButton Grid.Column="2" x:Name="LockAppToggle"
                                              Style="{StaticResource ToggleButtonStyle}"
                                              IsChecked="False"/>
                            </Grid>
                        </Border>

                        <Button x:Name="SavePrivacySettings" 
                                Content="💾 СОХРАНИТЬ НАСТРОЙКИ" 
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#0f3460" Width="200" Height="45"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== ВКЛАДКА: О ПРОГРАММЕ ===== -->
            <TabItem Header="ℹ️ О ПРОГРАММЕ">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              Padding="20">
                    <StackPanel>
                        <Label Style="{StaticResource SectionHeaderStyle}" 
                               Content="ИНФОРМАЦИЯ О ПРИЛОЖЕНИИ"/>

                        <Border Background="#0f3460" CornerRadius="10" 
                                Padding="30" Margin="0,0,0,15">
                            <StackPanel HorizontalAlignment="Center">
                                <Label Content="📱" FontSize="64" 
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <Label Content="МЕССЕНДЖЕР v2.0" 
                                       FontFamily="Segoe UI Black" FontSize="24"
                                       Foreground="White" HorizontalAlignment="Center"/>
                                <Label Content="Современный мессенджер с шифрованием" 
                                       FontFamily="Segoe UI" FontSize="14"
                                       Foreground="#aaaaaa" HorizontalAlignment="Center"
                                       Margin="0,0,0,5"/>
                                <Label Content="© 2026 Все права защищены" 
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#666666" HorizontalAlignment="Center"/>

                                <Grid Margin="0,20,0,0" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="ПРОВЕРИТЬ ОБНОВЛЕНИЯ" 
                                            Style="{StaticResource ActionButtonStyle}"
                                            Background="#0f3460" Width="180" Margin="0,0,10,0"
                                            />
                                    <Button Grid.Column="1" Content="ОТКРЫТЬ САЙТ" 
                                            Style="{StaticResource ActionButtonStyle}"
                                            Background="#0f3460" Width="120"
                                            />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Border Background="#1a1a2e" CornerRadius="8" Padding="10,5" Margin="0,0,10,0">
                                        <Label Content="Разработчик: YourName" 
                                               FontFamily="Segoe UI" FontSize="12"
                                               Foreground="#888888"/>
                                    </Border>
                                    <Border Background="#1a1a2e" CornerRadius="8" Padding="10,5">
                                        <Label Content="Лицензия: MIT" 
                                               FontFamily="Segoe UI" FontSize="12"
                                               Foreground="#888888"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>